			</fk>
			<fk name="fk_books_meetings" to_schema="db_clube_de_leitura" to_table="meetings" >
				<fk_column name="id" pk="book_id" />
			</fk>
			<fk name="fk_books_book_ratings" to_schema="db_clube_de_leitura" to_table="book_ratings" options="" >
				<fk_column name="id" pk="book_id" />
			</fk>
			<fk name="fk_books_group_books_read" to_schema="db_clube_de_leitura" to_table="group_books_read" >
				<fk_column name="id" pk="book_id" />
			</fk>
		</table>
		<table name="cities" prior="tbl_0" >
			<column name="id" type="uuid" mandatory="y" />
			<column name="name" type="varchar" length="100" mandatory="y" />
